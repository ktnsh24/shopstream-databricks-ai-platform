# =============================================================================
# Helix AI Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.
# =============================================================================

# --- Azure ---
AZURE_TENANT_ID=<your-azure-tenant-id>
AZURE_CLIENT_ID=<service-principal-client-id>
AZURE_CLIENT_SECRET=<service-principal-client-secret>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=helix-prod-rg

# --- Azure Storage (ADLS Gen2) ---
ADLS_ACCOUNT_NAME=helixprodadls
ADLS_CONTAINER_NAME=helix-lake

# --- Azure Event Hubs ---
EVENT_HUBS_NAMESPACE=helix-prod-eventhubs
EVENT_HUBS_NAME=orders-stream
EVENT_HUBS_CONNECTION_STRING=<from-azure-key-vault>

# --- Azure Key Vault ---
KEY_VAULT_NAME=helix-prod-kv
KEY_VAULT_URI=https://helix-prod-kv.vault.azure.net/

# --- Azure Container Apps ---
CONTAINER_APP_NAME=helix-api
CONTAINER_REGISTRY=helixprodacr.azurecr.io

# --- Databricks ---
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<from-azure-key-vault>
DATABRICKS_CLUSTER_ID=<your-cluster-id>
DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>

# --- Unity Catalog ---
UNITY_CATALOG_METASTORE_ID=<your-metastore-id>
UC_CATALOG_BRONZE=helix_bronze
UC_CATALOG_SILVER=helix_silver
UC_CATALOG_GOLD=helix_gold

# --- Mosaic AI / Model Serving ---
MODEL_SERVING_ENDPOINT_FORECAST=helix-forecasting-endpoint
MODEL_SERVING_ENDPOINT_CHURN=helix-churn-endpoint
FOUNDATION_MODEL_ENDPOINT=databricks-llama-3-3-70b-instruct

# --- Mosaic AI Vector Search ---
VECTOR_SEARCH_ENDPOINT=helix-vector-search
VECTOR_SEARCH_INDEX_CUSTOMER=helix_gold.default.customer_metrics_index
VECTOR_SEARCH_INDEX_DOCS=helix_gold.default.business_docs_index

# --- Unity AI Gateway ---
AI_GATEWAY_ROUTE=helix-llm-gateway

# --- MLflow ---
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_FORECASTING=/helix/forecasting
MLFLOW_EXPERIMENT_CHURN=/helix/churn

# --- API Gateway (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=prod
API_LOG_LEVEL=info

# --- Delta Sharing ---
DELTA_SHARING_PROFILE_PATH=<path-to-sharing-profile.share>

# --- Hands-on labs: config-tuning knobs ---
# Data platform labs
BRONZE_BATCH_TRIGGER_INTERVAL=60s
STREAMING_WATERMARK_DELAY=10 minutes
OPTIMIZE_ZORDER_COLUMNS=order_date,customer_id
AUTO_BROADCAST_JOIN_THRESHOLD_MB=10

# ML labs
ML_TRAIN_TEST_SPLIT=0.25
ML_OPTUNA_N_TRIALS=50
MODEL_SERVING_SCALE_TO_ZERO=true

# AI labs
VECTOR_SEARCH_NUM_RESULTS=5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
AGENT_MAX_STEPS=10
AI_GATEWAY_RATE_LIMIT_PER_MINUTE=100

# Evaluation
EVAL_MODE=rule_based          # rule_based | llm_judge | combined
EVAL_FAITHFULNESS_THRESHOLD=0.7
